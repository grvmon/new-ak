</section><section class="scroll-mt-16 mb-24 pb-16 border-b-[0.5px] border-[#55555a26]" id="04-color">
<h2 class="font-serif text-2xl font-normal text-[#1C1C1E] mb-2">04. Color</h2><div>
<h3>Token Map &amp; Contrast Matrix</h3>
<table>
<tr>
<th class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.85rem] uppercase tracking-[0.12em] text-[#55555A]">Role</th>
<th class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.85rem] uppercase tracking-[0.12em] text-[#55555A]">Token Name</th>
<th class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.85rem] uppercase tracking-[0.12em] text-[#55555A]">Hex/Value</th>
<th class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.85rem] uppercase tracking-[0.12em] text-[#55555A]">Contrast (vs Canvas)</th>
</tr>
<tr>
<td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">Canvas Light</td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]"><code>--titanium-frost</code></td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">#FAFAFA</td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">N/A</td>
</tr>
<tr>
<td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">Canvas Dark (Anchor)</td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]"><code>--obsidian-black</code></td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">#1C1C1E</td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">18.9:1 (AAA)</td>
</tr>
<tr>
<td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">Primary Accent</td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]"><code>--text-copper-aaa</code></td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">#804526</td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">7.2:1 (AAA)</td>
</tr>
<tr>
<td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">Highlight Accent</td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]"><code>--highlight-peach</code></td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">#e5b899</td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">10.9:1 (On Obsidian)</td>
</tr>
<tr>
<td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">Secondary Text</td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]"><code>--neutral-grey</code></td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">#55555A</td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">7.1:1 (AAA)</td>
</tr>
<tr>
<td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">Hairline Divider</td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]"><code>--divider</code></td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">rgba(85, 85, 90, 0.15)</td><td class="text-left py-4 px-4 border-b-[0.5px] border-[#55555a26] text-[0.95rem] text-[#1C1C1E]">Structural</td>
</tr>
</table>
</div>
<p class="font-sans text-[1rem] text-[#55555A] max-w-3xl mb-12 leading-relaxed">A strict 5-variable system. Contrast ratios are tracked.</p>
<div class="grid grid-cols-2 lg:grid-cols-3 xl:grid-cols-6 gap-6">
<div class="rounded-sm overflow-hidden border-[0.5px] border-[#55555a1a] bg-white flex flex-col">
<div class="relative flex items-end py-3 px-4 h-[120px] w-full bg-[#1C1C1E]"></div>
<div class="p-5 flex-1">
<div class="font-sans font-bold text-[0.95rem] text-[#1C1C1E] mb-1">Obsidian Black (Anchor)</div>
<div class="font-sans text-[0.8rem] text-[#55555A] tabular-nums mb-2 tracking-[0.02em]">#1C1C1E</div>
</div>
</div>
<div class="rounded-sm overflow-hidden border-[0.5px] border-[#55555a1a] bg-white flex flex-col">
<div class="relative flex items-end py-3 px-4 h-[120px] w-full bg-[#FAFAFA]"></div>
<div class="p-5 flex-1">
<div class="font-sans font-bold text-[0.95rem] text-[#1C1C1E] mb-1">Titanium Frost (Canvas)</div>
<div class="font-sans text-[0.8rem] text-[#55555A] tabular-nums mb-2 tracking-[0.02em]">#FAFAFA</div>
</div>
</div>
<div class="rounded-sm overflow-hidden border-[0.5px] border-[#55555a1a] bg-white flex flex-col">
<div class="relative flex items-end py-3 px-4 h-[120px] w-full bg-gradient-to-br from-[#be7555] to-[#9f5334]"></div>
<div class="p-5 flex-1">
<div class="font-sans font-bold text-[0.95rem] text-[#1C1C1E] mb-1">Primary Copper (CTA)</div>
<div class="font-sans text-[0.8rem] text-[#55555A] tabular-nums mb-2 tracking-[0.02em]">#be7555 → #9f5334</div>
</div>
</div>
<div class="rounded-sm overflow-hidden border-[0.5px] border-[#55555a1a] bg-white flex flex-col">
<div class="relative flex items-end py-3 px-4 h-[120px] w-full bg-[#804526]"></div>
<div class="p-5 flex-1">
<div class="font-sans font-bold text-[0.95rem] text-[#1C1C1E] mb-1">Text Copper (AAA)</div>
<div class="font-sans text-[0.8rem] text-[#55555A] tabular-nums mb-2 tracking-[0.02em]">#804526 (7.2:1 Ratio)</div>
</div>
</div>
<div class="rounded-sm overflow-hidden border-[0.5px] border-[#55555a1a] bg-white flex flex-col">
<div class="relative flex items-end py-3 px-4 h-[120px] w-full bg-[#55555A]"></div>
<div class="p-5 flex-1">
<div class="font-sans font-bold text-[0.95rem] text-[#1C1C1E] mb-1">Muted Slate (Body)</div>
<div class="font-sans text-[0.8rem] text-[#55555A] tabular-nums mb-2 tracking-[0.02em]">#55555A</div>
</div>
</div>
</div>
<h3 class="font-serif text-[1.25rem] font-bold text-[#1C1C1E] mt-16 mb-4">Architectural Semantic Palette</h3>
