---
import '../styles/global.css';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import DossierCard from '../components/ui/DossierCard.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Pagination from '../components/ui/Pagination.astro';
import Alert from '../components/ui/Alert.astro';
import ProcessCard from '../components/ui/ProcessCard.astro';
import ChecklistCard from '../components/ui/ChecklistCard.astro';
import TeamProfile from '../components/ui/TeamProfile.astro';
import VideoOverlay from '../components/ui/VideoOverlay.astro';

import Accordion from '../components/ui/Accordion.tsx';
import Tabs from '../components/ui/Tabs.tsx';
import Calculator from '../components/ui/Calculator.tsx';
import Gallery from '../components/ui/Gallery.tsx';
import Modal from '../components/ui/Modal.tsx';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Acre&Key Master Design System</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Marcellus&display=swap" rel="stylesheet">
  </head>
  <body class="bg-canvas-light text-canvas-dark">
    
    <header class="sticky top-0 z-header cinematic-blur-nav border-b-[0.5px] border-[#55555a26]">
      <div class="ak-container py-4 flex justify-between items-center">
        <a href="/" class="font-serif text-2xl tracking-tight text-canvas-dark">acre&key</a>
        <nav class="hidden md:flex space-x-8">
          <a href="#components" class="font-sans text-[0.85rem] uppercase tracking-[0.05em] font-bold text-neutral-grey hover:text-primary-copper transition-colors">Components</a>
          <a href="#patterns" class="font-sans text-[0.85rem] uppercase tracking-[0.05em] font-bold text-neutral-grey hover:text-primary-copper transition-colors">Patterns</a>
        </nav>
        <Button variant="primary" class="text-xs px-4 py-2">Request Callback</Button>
      </div>
    </header>

    <div class="section-obsidian py-24 px-6 lg:px-12 text-center">
      <h1 class="text-white mb-4">The Master Design System</h1>
      <p class="font-sans text-lg opacity-80 max-w-2xl mx-auto">Institutional-Grade Design System. Uncompromising architecture for Acre&amp;Key.</p>
    </div>

    <div class="ak-container py-16 flex flex-col lg:flex-row gap-16">
      <nav class="hidden lg:block w-64 shrink-0 font-sans sticky top-24 self-start h-[calc(100vh-8rem)] overflow-auto border-r-[0.5px] border-[#55555a26] pr-8">
        <div class="text-[0.75rem] font-bold tracking-[0.15em] uppercase text-primary-copper mt-6 mb-2">Visual Language</div>
        <a href="#typography" class="block py-1 text-[0.85rem] text-neutral-grey hover:text-primary-copper transition-colors">Typography</a>
        <a href="#components" class="block py-1 text-[0.85rem] text-neutral-grey hover:text-primary-copper transition-colors">Components</a>
        <a href="#data" class="block py-1 text-[0.85rem] text-neutral-grey hover:text-primary-copper transition-colors">Data & Tools</a>
        <a href="#patterns" class="block py-1 text-[0.85rem] text-neutral-grey hover:text-primary-copper transition-colors">Patterns</a>
      </nav>

      <main class="flex-1 min-w-0">

        <!-- 5. TYPOGRAPHY -->
        <section id="typography" class="mb-24 pb-16 hairline-b">
          <h2>Typography & Hierarchy</h2>
          <div class="space-y-8 mt-8">
            <div>
              <div class="overline-kicker text-neutral-grey mb-2">Display Title (H1)</div>
              <h1>The Architecture of Wealth</h1>
            </div>
            <div>
              <div class="overline-kicker text-neutral-grey mb-2">Section Heading (H2)</div>
              <h2>Institutional Grade diligence.</h2>
            </div>
            <div>
              <div class="overline-kicker text-neutral-grey mb-2">Body & Lead Text</div>
              <p style="font-size: var(--text-fluid-lead)">We filter out the noise in the market to bring you absolute clarity. Our independent advisory evaluates the opportunity, uncovers the risks, and negotiates entirely on your behalf.</p>
            </div>
          </div>
        </section>

        <!-- 9. COMPONENTS -->
        <section id="components" class="mb-24 pb-16 hairline-b">
          <h2>Components & Inputs</h2>
          
          <div class="space-y-12 mt-8">
            <Card class="max-w-lg">
              <h3 class="font-sans text-lg mb-6">Concierge Advisory Form</h3>
              <form class="space-y-6">
                <div>
                  <label class="block text-[0.85rem] font-bold mb-2">Full Legal Name</label>
                  <input type="text" class="w-full" placeholder="John Doe" />
                </div>
                <div class="flex gap-6 items-center">
                  <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" name="diligence" />
                    <span class="text-[0.95rem]">Legal Dossier</span>
                  </label>
                  <label class="flex items-center gap-3 cursor-pointer">
                    <input type="radio" name="horizon" checked />
                    <span class="text-[0.95rem]">Ready to Move</span>
                  </label>
                </div>
                <Button variant="primary" class="w-full mt-4">Request Advisory Call</Button>
              </form>
            </Card>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">React Accordion (ARIA)</div>
              <Accordion client:load items={[
                { id: '1', title: 'What is the legal land title status?', content: 'The land title has been verified across 40 years of records. It possesses an A-Khata certification with zero encumbrances.' },
                { id: '2', title: 'What are the township details?', content: 'Masterplan audited for hyper-density risk metrics.' }
              ]} />
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">React Tabs (ARIA)</div>
              <Tabs client:load items={[
                { id: 'fin', label: 'Financials', content: <p>Comprehensive financial modeling and ROI projections.</p> },
                { id: 'plan', label: 'Masterplan', content: <p>24 Acre development with 80% open space.</p> },
                { id: 'dil', label: 'Diligence', content: <p>69-point legal and structural verification completed.</p> }
              ]} />
            </div>
          </div>
        </section>

        <!-- 10. DATA & TOOLS -->
        <section id="data" class="mb-24 pb-16 hairline-b">
          <h2>Data & Tools</h2>
          <div class="space-y-12 mt-8">
            
            <Calculator client:load />

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Alerts & Tooltips</div>
              <Alert title="Report Dispatched">
                The 69-point buyer analysis has been securely emailed to your registered address.
              </Alert>
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Pagination</div>
              <Pagination currentPage={2} totalPages={8} baseUrl="/blog/" />
            </div>
            
            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Breadcrumbs</div>
              <Breadcrumbs crumbs={[{label: 'Home', href: '/'}, {label: 'Advisory', href: '/advisory'}]} current="Prestige Evergreen" />
            </div>

          </div>
        </section>

        <!-- 11. PATTERNS -->
        <section id="patterns" class="mb-24 pb-16">
          <h2>Templates & Patterns</h2>
          
          <div class="space-y-12 mt-8">
            <div>
              <div class="overline-kicker text-neutral-grey mb-4">The Asset Dossier Card</div>
              <DossierCard 
                title="Prestige Evergreen"
                location="Whitefield, Bengaluru"
                typology="3 & 4 BHK"
                price="₹ 3.14 Cr"
                imageSrc="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&q=80&w=800"
                href="#"
              />
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Editorial Process Card</div>
              <ProcessCard step="01" title="Clarify">
                Mandate calibration & comprehensive requirement definition. Family lifestyle, commute radii (ORR/Silk Board) & non-negotiables.
              </ProcessCard>
            </div>

            <div class="max-w-md">
              <div class="overline-kicker text-neutral-grey mb-4">Editorial Checklist Card</div>
              <ChecklistCard badgeText="Location" title="Connectivity, Security & Demand">
                <li>Employment & IT corridor connectivity</li>
                <li>Metro line progress & road widening realities</li>
                <li>Ground-water security & social infra data</li>
              </ChecklistCard>
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Executive Team Profile</div>
              <TeamProfile 
                name="Gaurav Mongia"
                role="Marketing · Product · Tech"
                imageSrc="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&q=80&w=800"
              >
                Decade-long real estate & digital marketing experience, bridging buyers with clarity.
              </TeamProfile>
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Cinematic Gallery Player (React)</div>
              <Gallery client:load title="Prestige Raintree Park" images={[
                { src: 'https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&q=80&w=1200', alt: 'Exterior' },
                { src: 'https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&q=80&w=1200', alt: 'Living Room' }
              ]} />
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Video Overlay</div>
              <VideoOverlay title="The Masterplan Walkthrough" thumbnailSrc="https://images.unsplash.com/photo-1600607686527-6fb886090705?auto=format&fit=crop&q=80&w=1200" />
            </div>
            
          </div>
        </section>

      </main>
    </div>

    <footer class="section-obsidian py-16">
      <div class="ak-container">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="md:col-span-2">
            <h2 class="font-serif text-2xl tracking-tight text-white mb-4">acre&key</h2>
            <p class="font-sans text-[0.95rem] text-white/70 max-w-sm">Institutional-grade real estate advisory for the institutional investor.</p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
