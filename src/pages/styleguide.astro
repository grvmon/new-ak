<script>
document.addEventListener('DOMContentLoaded', () => {
    const sections = document.querySelectorAll('section[id]');
    const navLinks = document.querySelectorAll('.ds-nav a');
    
    const observer = new IntersectionObserver((entries) => {
        let visibleSection = null;
        entries.forEach(entry => {
            if (entry.isIntersecting) visibleSection = entry.target;
        });
        
        if (visibleSection) {
            navLinks.forEach(link => {
                if (link.getAttribute('href') === '#' + visibleSection.id) {
                    link.setAttribute('aria-current', 'true');
                } else {
                    link.removeAttribute('aria-current');
                }
            });
        }
    }, { rootMargin: '-20% 0px -80% 0px' });
    
    sections.forEach(sec => observer.observe(sec));

    // INTERACTIVE COMPONENTS LOGIC (TABS & ACCORDIONS)
    
    // 1. Accordions
    const accordions = document.querySelectorAll('.ds-accordion-trigger');
    accordions.forEach(acc => {
        acc.addEventListener('click', () => {
            const isExpanded = acc.getAttribute('aria-expanded') === 'true';
            // Close all others (optional, but good for clean UI)
            accordions.forEach(a => {
                a.setAttribute('aria-expanded', 'false');
                a.querySelector('.ds-accordion-icon').textContent = '+';
            });
            // Toggle clicked
            if (!isExpanded) {
                acc.setAttribute('aria-expanded', 'true');
                acc.querySelector('.ds-accordion-icon').textContent = '-';
            }
        });
    });

    // 2. Tabs (Top and Side)
    const tabContainers = document.querySelectorAll('.ds-tab-container');
    tabContainers.forEach(container => {
        const tabs = container.querySelectorAll('[role="tab"]');
        const panels = container.querySelectorAll('.ds-tab-panel');
        
        tabs.forEach(tab => {
            tab.addEventListener('click', () => {
                // Deactivate all
                tabs.forEach(t => t.setAttribute('aria-selected', 'false'));
                panels.forEach(p => p.setAttribute('data-active', 'false'));
                
                // Activate clicked
                tab.setAttribute('aria-selected', 'true');
                const targetId = tab.getAttribute('data-target');
                container.querySelector('#' + targetId).setAttribute('data-active', 'true');
            });
        });
    });

});
</script>
