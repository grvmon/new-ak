---
import '../styles/global.css';
import Button from '../components/ui/Button.astro';
import Badge from '../components/ui/Badge.astro';
import Card from '../components/ui/Card.astro';
import DossierCard from '../components/ui/DossierCard.astro';
import Breadcrumbs from '../components/ui/Breadcrumbs.astro';
import Pagination from '../components/ui/Pagination.astro';
import Alert from '../components/ui/Alert.astro';
import ProcessCard from '../components/ui/ProcessCard.astro';
import ChecklistCard from '../components/ui/ChecklistCard.astro';
import TeamProfile from '../components/ui/TeamProfile.astro';
import VideoOverlay from '../components/ui/VideoOverlay.astro';
import PersonaCard from '../components/ui/PersonaCard.astro';

import Accordion from '../components/ui/Accordion.tsx';
import Tabs from '../components/ui/Tabs.tsx';
import Calculator from '../components/ui/Calculator.tsx';
import Gallery from '../components/ui/Gallery.tsx';
import Modal from '../components/ui/Modal.tsx';
import OtpForm from '../components/ui/OtpForm.tsx';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Acre&Key Master Design System</title>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Marcellus&display=swap" rel="stylesheet">
  </head>
  <body class="bg-canvas-light text-canvas-dark">
    
    <header class="sticky top-0 z-header cinematic-blur-nav border-b-[0.5px] border-[#55555a26]">
      <div class="ak-container py-4 flex justify-between items-center">
        <a href="/" class="font-serif text-2xl tracking-tight text-canvas-dark">acre&key</a>
        <nav class="hidden md:flex space-x-8">
          <a href="#components" class="font-sans text-[0.85rem] uppercase tracking-[0.05em] font-bold text-neutral-grey hover:text-primary-copper transition-colors">Components</a>
          <a href="#patterns" class="font-sans text-[0.85rem] uppercase tracking-[0.05em] font-bold text-neutral-grey hover:text-primary-copper transition-colors">Patterns</a>
        </nav>
        <Button variant="primary" class="text-xs px-4 py-2">Request Callback</Button>
      </div>
    </header>

    <div class="section-obsidian py-24 px-6 lg:px-12 text-center">
      <h1 class="text-white mb-4">The Master Design System</h1>
      <p class="font-sans text-lg opacity-80 max-w-2xl mx-auto">Institutional-Grade Design System. Uncompromising architecture for Acre&amp;Key.</p>
    </div>

    <div class="ak-container py-16 flex flex-col lg:flex-row gap-16">
      <nav class="hidden lg:block w-64 shrink-0 font-sans sticky top-24 self-start h-[calc(100vh-8rem)] overflow-auto border-r-[0.5px] border-[#55555a26] pr-8">
        
        <div class="text-[0.75rem] font-bold tracking-[0.15em] uppercase text-primary-copper mb-2">Foundations</div>
        <a href="#governance-meta" class="block py-1 text-[0.85rem] text-neutral-grey hover:text-primary-copper transition-colors">Governance</a>
        <a href="#brand" class="block py-1 text-[0.85rem] text-neutral-grey hover:text-primary-copper transition-colors">Colors</a>
        <a href="#voice" class="block py-1 text-[0.85rem] text-neutral-grey hover:text-primary-copper transition-colors">Lexicon & Tone</a>

        <div class="text-[0.75rem] font-bold tracking-[0.15em] uppercase text-primary-copper mt-6 mb-2">Visual Language</div>
        <a href="#identity" class="block py-1 text-[0.85rem] text-neutral-grey hover:text-primary-copper transition-colors">Identity & Logo</a>
        <a href="#typography" class="block py-1 text-[0.85rem] text-neutral-grey hover:text-primary-copper transition-colors">Typography</a>
        
        <div class="text-[0.75rem] font-bold tracking-[0.15em] uppercase text-primary-copper mt-6 mb-2">Components</div>
        <a href="#components" class="block py-1 text-[0.85rem] text-neutral-grey hover:text-primary-copper transition-colors">Actions & Inputs</a>
        
        <div class="text-[0.75rem] font-bold tracking-[0.15em] uppercase text-primary-copper mt-6 mb-2">Data & Tools</div>
        <a href="#data" class="block py-1 text-[0.85rem] text-neutral-grey hover:text-primary-copper transition-colors">Tables & Tools</a>
        
        <div class="text-[0.75rem] font-bold tracking-[0.15em] uppercase text-primary-copper mt-6 mb-2">Patterns</div>
        <a href="#patterns" class="block py-1 text-[0.85rem] text-neutral-grey hover:text-primary-copper transition-colors">Templates & Patterns</a>
      </nav>

      <main class="flex-1 min-w-0">

        <!-- 0. GOVERNANCE -->
        <section id="governance-meta" class="mb-24 pb-16 hairline-b">
          <h2>0. Governance & Versioning</h2>
          <p class="font-sans text-[1rem] text-neutral-grey max-w-3xl mb-12 leading-relaxed">
            <strong>Version:</strong> 2.0.0 (Apple-Grade Architectural Release)<br/>
            <strong>Owner:</strong> Acre&amp;Key Design Authority<br/>
            <strong>Changelog:</strong> Pivot from Warm Ivory to Titanium Frost, shift from Cormorant to Marcellus, implementation of strict 7.0:1 AAA contrast and 4px micro-edge geometry.
          </p>
        </section>

        <!-- 1-3. FOUNDATIONS -->
        <section id="brand" class="mb-24 pb-16 hairline-b">
          <h2>1. Master Foundations & Colors</h2>
          <div class="mt-8 grid grid-cols-2 md:grid-cols-5 gap-6">
            <div class="rounded-sm overflow-hidden border-[0.5px] border-[#55555a26] bg-white">
              <div class="h-32 w-full bg-canvas-dark"></div>
              <div class="p-4">
                <div class="font-sans font-bold text-[0.95rem] text-canvas-dark mb-1">Obsidian Black</div>
                <div class="font-sans text-[0.8rem] text-neutral-grey tracking-wide">#1C1C1E</div>
              </div>
            </div>
            <div class="rounded-sm overflow-hidden border-[0.5px] border-[#55555a26] bg-white">
              <div class="h-32 w-full bg-canvas-light border-b-[0.5px] border-[#55555a26]"></div>
              <div class="p-4">
                <div class="font-sans font-bold text-[0.95rem] text-canvas-dark mb-1">Titanium Frost</div>
                <div class="font-sans text-[0.8rem] text-neutral-grey tracking-wide">#FAFAFA</div>
              </div>
            </div>
            <div class="rounded-sm overflow-hidden border-[0.5px] border-[#55555a26] bg-white">
              <div class="h-32 w-full bg-primary-copper"></div>
              <div class="p-4">
                <div class="font-sans font-bold text-[0.95rem] text-canvas-dark mb-1">Text Copper</div>
                <div class="font-sans text-[0.8rem] text-neutral-grey tracking-wide">#804526</div>
              </div>
            </div>
          </div>
        </section>

        <section id="voice" class="mb-24 pb-16 hairline-b">
          <h2>2. Clinical Lexicon & Tone</h2>
          <p class="font-sans text-[1rem] text-neutral-grey max-w-3xl mb-8 leading-relaxed">HNI buyers ignore generic marketing jargon. We operate as independent, data-driven advisors.</p>
          <table class="w-full text-left ak-table border-collapse">
            <thead>
              <tr class="border-b-[0.5px] border-[#55555a26]">
                <th class="py-4 font-sans text-[0.85rem] font-bold text-neutral-grey">Banned Marketing Fluff</th>
                <th class="py-4 font-sans text-[0.85rem] font-bold text-neutral-grey">Approved Clinical Terminology</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="text-neutral-grey line-through">"Buy Now" / "Submit"</td>
                <td class="text-primary-copper font-bold">"Request Advisory Call"</td>
              </tr>
              <tr>
                <td class="text-neutral-grey line-through">"Luxury" / "Premium"</td>
                <td class="text-primary-copper font-bold">"Institutional-Grade"</td>
              </tr>
            </tbody>
          </table>
        </section>

        <!-- 4. IDENTITY & LOGO -->
        <section id="identity" class="mb-24 pb-16 hairline-b">
          <h2>Identity & Logo Architecture</h2>
          <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-4">
            <div class="bg-[#FAFAFA] p-12 flex flex-col items-center justify-center border-[0.5px] border-[#55555a26]">
              <div class="overline-kicker text-neutral-grey mb-4 text-[0.65rem]">Titanium Frost Environment</div>
              <div class="font-serif text-3xl tracking-tight text-[#1C1C1E]">acre<span class="font-sans font-light">&amp;</span>key</div>
            </div>
            <div class="bg-[#1C1C1E] p-12 flex flex-col items-center justify-center border-[0.5px] border-white/10">
              <div class="overline-kicker text-white/50 mb-4 text-[0.65rem]">Obsidian Environment</div>
              <div class="font-serif text-3xl tracking-tight text-white">acre<span class="font-sans font-light">&amp;</span>key</div>
            </div>
            <div class="bg-[#804526] p-12 flex flex-col items-center justify-center">
              <div class="overline-kicker text-white/50 mb-4 text-[0.65rem]">Primary Copper Environment</div>
              <div class="font-serif text-3xl tracking-tight text-white">acre<span class="font-sans font-light">&amp;</span>key</div>
            </div>
            <div class="relative p-12 flex flex-col items-center justify-center overflow-hidden">
              <img src="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&q=80&w=800" class="absolute inset-0 w-full h-full object-cover img-filtered" />
              <div class="absolute inset-0 bg-[#1C1C1E]/60 backdrop-blur-[2px]"></div>
              <div class="overline-kicker text-white/50 mb-4 text-[0.65rem] relative z-10">Cinematic Image Overlay</div>
              <div class="font-serif text-3xl tracking-tight text-white relative z-10">acre<span class="font-sans font-light">&amp;</span>key</div>
            </div>
          </div>
        </section>

        <!-- 5. TYPOGRAPHY -->
        <section id="typography" class="mb-24 pb-16 hairline-b">
          <h2>Typography & Hierarchy</h2>
          <div class="space-y-8 mt-8">
            <div>
              <div class="overline-kicker text-neutral-grey mb-2">Display Title (H1)</div>
              <h1>The Architecture of Wealth</h1>
            </div>
            <div>
              <div class="overline-kicker text-neutral-grey mb-2">Section Heading (H2)</div>
              <h2>Institutional Grade diligence.</h2>
            </div>
            <div>
              <div class="overline-kicker text-neutral-grey mb-2">Body & Lead Text</div>
              <p style="font-size: var(--text-fluid-lead)">We filter out the noise in the market to bring you absolute clarity. Our independent advisory evaluates the opportunity, uncovers the risks, and negotiates entirely on your behalf.</p>
            </div>
          </div>
        </section>

        <!-- 9. COMPONENTS -->
        <section id="components" class="mb-24 pb-16 hairline-b">
          <h2>Components & Inputs</h2>
          
          <div class="space-y-12 mt-8">
            <Card class="max-w-lg">
              <h3 class="font-sans text-lg mb-6">Standard Capture Form</h3>
              <form class="space-y-6">
                <div>
                  <label class="block text-[0.85rem] font-bold mb-2">Full Legal Name</label>
                  <input type="text" class="w-full border-b-[0.5px] border-[#55555a4d] pb-3 focus:outline-none focus:border-primary-copper transition-colors text-[0.95rem] bg-transparent" placeholder="John Doe" />
                </div>
                <div class="flex gap-6 items-center">
                  <label class="flex items-center gap-3 cursor-pointer">
                    <input type="checkbox" name="diligence" />
                    <span class="text-[0.95rem]">Legal Dossier</span>
                  </label>
                  <label class="flex items-center gap-3 cursor-pointer">
                    <input type="radio" name="horizon" checked />
                    <span class="text-[0.95rem]">Ready to Move</span>
                  </label>
                </div>
                <Button variant="primary" class="w-full mt-4">Request Advisory Call</Button>
              </form>
            </Card>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Concierge Advisory Form (OTP)</div>
              <OtpForm client:load />
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Menu States (Dark & Light)</div>
              <div class="bg-[#1C1C1E] p-8 flex space-x-8 mb-4">
                <a href="#" class="font-sans text-[0.85rem] font-bold text-white uppercase tracking-[0.05em] hover:text-[#e5b899] transition-colors">Framework</a>
                <a href="#" class="font-sans text-[0.85rem] font-bold text-white uppercase tracking-[0.05em] hover:text-[#e5b899] transition-colors">Advisory</a>
              </div>
              <div class="bg-[#FAFAFA] p-8 flex space-x-8 border-[0.5px] border-[#55555a26]">
                <a href="#" class="font-sans text-[0.85rem] font-bold text-[#55555A] uppercase tracking-[0.05em] hover:text-[#804526] transition-colors">Dossiers</a>
                <a href="#" class="font-sans text-[0.85rem] font-bold text-[#55555A] uppercase tracking-[0.05em] hover:text-[#804526] transition-colors">About Us</a>
              </div>
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Cinematic Modal</div>
              <Modal client:load title="Floorplan Access" triggerText="Authenticate & View">
                <p>Please confirm your credentials to view the highly detailed architectural layouts.</p>
              </Modal>
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">React Accordion (ARIA)</div>
              <Accordion client:load items={[
                { id: '1', title: 'What is the legal land title status?', content: 'The land title has been verified across 40 years of records. It possesses an A-Khata certification with zero encumbrances.' },
                { id: '2', title: 'What are the township details?', content: 'Masterplan audited for hyper-density risk metrics.' }
              ]} />
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">React Tabs (ARIA)</div>
              <Tabs client:load items={[
                { id: 'fin', label: 'Financials', content: 'Comprehensive financial modeling and ROI projections.' },
                { id: 'plan', label: 'Masterplan', content: '24 Acre development with 80% open space.' },
                { id: 'dil', label: 'Diligence', content: '69-point legal and structural verification completed.' }
              ]} />
            </div>
          </div>
        </section>

        <!-- 10. DATA & TOOLS -->
        <section id="data" class="mb-24 pb-16 hairline-b">
          <h2>Data & Tools</h2>
          <div class="space-y-12 mt-8">
            
            <Calculator client:load />

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Alerts & Tooltips</div>
              <Alert title="Report Dispatched">
                The 69-point buyer analysis has been securely emailed to your registered address.
              </Alert>
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Pagination</div>
              <Pagination currentPage={2} totalPages={8} baseUrl="/blog/" />
            </div>
            
            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Financial Table</div>
              <table class="w-full text-left ak-table border-collapse">
                <thead>
                  <tr class="border-b-[0.5px] border-[#55555a26]">
                    <th class="py-4 font-sans text-[0.85rem] font-bold text-neutral-grey">Typology</th>
                    <th class="py-4 font-sans text-[0.85rem] font-bold text-neutral-grey">Carpet Area</th>
                    <th class="py-4 font-sans text-[0.85rem] font-bold text-neutral-grey text-right">Institutional Price</th>
                  </tr>
                </thead>
                <tbody>
                  <tr>
                    <td>3 BHK + Staff</td>
                    <td>2,204 Sq.Ft.</td>
                    <td class="text-right">₹ 3.14 Cr</td>
                  </tr>
                  <tr>
                    <td>4 BHK Signature</td>
                    <td>3,150 Sq.Ft.</td>
                    <td class="text-right">₹ 4.85 Cr</td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Architectural Lists</div>
              <ul class="space-y-3 font-sans text-[0.95rem] text-neutral-grey">
                <li class="flex items-start gap-3">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-1 text-canvas-dark shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Title deeds verified against RERA database.</span>
                </li>
                <li class="flex items-start gap-3">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mt-1 text-canvas-dark shrink-0"><polyline points="20 6 9 17 4 12"></polyline></svg>
                  <span>Masterplan audited for hyper-density risk metrics.</span>
                </li>
              </ul>
            </div>
            
            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Breadcrumbs</div>
              <Breadcrumbs crumbs={[{label: 'Home', href: '/'}, {label: 'Advisory', href: '/advisory'}]} current="Prestige Evergreen" />
            </div>

          </div>
        </section>

        <!-- 11. PATTERNS -->
        <section id="patterns" class="mb-24 pb-16">
          <h2>Templates & Patterns</h2>
          
          <div class="space-y-12 mt-8">
            
            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Hero Architecture Blueprint</div>
              <div class="grid grid-cols-1 md:grid-cols-2 bg-canvas-dark text-white rounded-sm overflow-hidden">
                <div class="p-12 flex flex-col justify-center">
                  <div class="overline-kicker text-white/50 mb-4">Pre-Launch Advisory</div>
                  <h3 class="font-serif text-3xl mb-4 leading-tight">Institutional-Grade Assets in Whitefield.</h3>
                  <p class="font-sans text-[0.95rem] text-white/80 leading-relaxed mb-8">Access proprietary risk-assessment frameworks before allocating capital to under-construction developments.</p>
                  <Button variant="primary" class="self-start">Get Buyer Analysis</Button>
                </div>
                <div class="h-[400px]">
                  <img src="https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&q=80&w=800" class="w-full h-full object-cover img-filtered" />
                </div>
              </div>
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Buyer Persona (Anchored Portrait)</div>
              <PersonaCard number="01." title="The Busy Executive" imageSrc="https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&q=80&w=800">
                <p>You know what you want. You just don't have the time to find it.</p>
                <p>For founders, CXOs and senior professionals seeking a better home across Whitefield, Indiranagar and ORR, without the endless sales conversations.</p>
                <p>We handle the search and diligence. You focus on the decision.</p>
              </PersonaCard>
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">The Asset Dossier Card</div>
              <DossierCard 
                title="Prestige Evergreen"
                location="Whitefield, Bengaluru"
                typology="3 & 4 BHK"
                price="₹ 3.14 Cr"
                imageSrc="https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?auto=format&fit=crop&q=80&w=800"
                href="#"
              />
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Editorial Process Card</div>
              <ProcessCard step="01" title="Clarify">
                Mandate calibration & comprehensive requirement definition. Family lifestyle, commute radii (ORR/Silk Board) & non-negotiables.
              </ProcessCard>
            </div>

            <div class="max-w-md">
              <div class="overline-kicker text-neutral-grey mb-4">Editorial Checklist Card</div>
              <ChecklistCard badgeText="Location" title="Connectivity, Security & Demand">
                <li>Employment & IT corridor connectivity</li>
                <li>Metro line progress & road widening realities</li>
                <li>Ground-water security & social infra data</li>
              </ChecklistCard>
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Executive Team Profile</div>
              <TeamProfile 
                name="Gaurav Mongia"
                role="Marketing · Product · Tech"
                imageSrc="https://images.unsplash.com/photo-1560250097-0b93528c311a?auto=format&fit=crop&q=80&w=800"
              >
                Decade-long real estate & digital marketing experience, bridging buyers with clarity.
              </TeamProfile>
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Cinematic Gallery Player (React)</div>
              <Gallery client:load title="Prestige Raintree Park" images={[
                { src: 'https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&q=80&w=1200', alt: 'Exterior' },
                { src: 'https://images.unsplash.com/photo-1600566753190-17f0baa2a6c3?auto=format&fit=crop&q=80&w=1200', alt: 'Living Room' }
              ]} />
            </div>

            <div>
              <div class="overline-kicker text-neutral-grey mb-4">Video Overlay</div>
              <VideoOverlay title="The Masterplan Walkthrough" thumbnailSrc="https://images.unsplash.com/photo-1600607686527-6fb886090705?auto=format&fit=crop&q=80&w=1200" />
            </div>
            
          </div>
        </section>

      </main>
    </div>

    <footer class="section-obsidian py-16">
      <div class="ak-container">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="md:col-span-2">
            <h2 class="font-serif text-2xl tracking-tight text-white mb-4">acre&key</h2>
            <p class="font-sans text-[0.95rem] text-white/70 max-w-sm">Institutional-grade real estate advisory for the institutional investor.</p>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
