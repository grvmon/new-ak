<input autocomplete="tel" class="w-full bg-[#8B3A3A]/5 border-[1px] border-[#8B3A3A]/40 text-[#1C1C1E] pl-12 pr-4 py-3 rounded-sm font-sans outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-[#8B3A3A] transition-colors" id="input-gen-1" type="text" value="98765 4"/>
<div class="absolute right-4 top-3.5 text-[#8B3A3A]">
