---
import '../styles/global.css';
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acre&Key | Home Buyer Concierge</title>
</head>
<body class="bg-[#1C1C1E] text-[#FAFAFA] antialiased selection:bg-[#BE7555] selection:text-white overflow-x-hidden font-sans">

    <!-- GLOBAL NAV -->
    <nav class="w-full bg-[#1C1C1E]/90 backdrop-blur-md border-b-[0.5px] border-white/10 h-16 flex items-center justify-between px-6 lg:px-12 fixed top-0 z-50">
        <div class="font-logo text-[1.15rem] font-semibold tracking-[-0.02em] text-[#FAFAFA]"><span class="font-logo lowercase">acre&amp;key</span></div>
        <div class="hidden md:flex items-center gap-8 text-[0.8rem] font-bold tracking-[0.1em] uppercase text-[#FAFAFA]/70">
            <a class="hover:text-[#FAFAFA] transition-colors" href="#">Properties</a>
            <a class="hover:text-[#FAFAFA] transition-colors" href="#">Advisory</a>
            <a class="hover:text-[#FAFAFA] transition-colors" href="#">Intelligence</a>
        </div>
        <button class="bg-[#BE7555] text-white px-5 py-2.5 rounded-sm font-sans text-[0.75rem] font-bold uppercase tracking-[0.1em] hover:bg-[#9F5334] transition-colors shadow-sm">
            Book Advisory
        </button>
    </nav>

    <main class="pt-16 bg-[#FAFAFA]">
        
        <!-- 1. HERO ARCHITECTURE -->
        <section class="relative w-full min-h-[90vh] md:min-h-[85vh] overflow-hidden flex flex-col justify-center border-b-[0.5px] border-[#1C1C1E]">
            <div class="absolute inset-0 bg-[url('/new-ak/assets/evergreen/prestige_evergreen_hero_skyline_night_aerial.webp')] bg-cover bg-center"></div>
            <!-- Gradient contrast zone -->
            <div class="absolute inset-0 bg-gradient-to-r from-[#1C1C1E] via-[#1C1C1E]/90 to-transparent w-[90%] md:w-[75%]"></div>
            
            <div class="relative z-10 p-8 md:p-16 lg:px-24 max-w-4xl flex flex-col gap-6 my-8">
                <div class="font-sans text-[0.7rem] font-bold tracking-[0.15em] uppercase text-[#FAFAFA]/70">Home Buyer Concierge</div>
                <h1 class="font-serif text-[3rem] md:text-[4rem] text-[#FAFAFA] leading-[1.1]">
                    Anyone can give options.<br/>
                    We help you buy <span class="text-[#BE7555]">the right home.</span>
                </h1>
                <p class="font-sans text-[1rem] md:text-[1.15rem] text-[#FAFAFA]/80 leading-relaxed max-w-lg mt-2">
                    Independent home buying advisory to evaluate the opportunity, uncover the risks, and negotiate on your behalf.
                </p>
                
                <div class="flex gap-12 mt-6 border-t-[0.5px] border-white/20 pt-8">
                    <div>
                        <div class="font-sans text-[1.75rem] text-[#FAFAFA] mb-1">69</div>
                        <div class="font-sans text-[0.8rem] text-[#FAFAFA]/60">Due Diligence Checks</div>
                    </div>
                    <div>
                        <div class="font-sans text-[1.75rem] text-[#FAFAFA] mb-1">₹0</div>
                        <div class="font-sans text-[0.8rem] text-[#FAFAFA]/60">Buyer Advisory Fee</div>
                    </div>
                </div>
                
                <div class="mt-6">
                    <button class="bg-[#BE7555] hover:bg-[#9F5334] text-white px-8 py-4 rounded-sm font-sans text-[0.9rem] font-semibold transition-colors flex items-center gap-3 w-fit">
                        Schedule Advisory Call 
                        <svg aria-hidden="true" fill="none" height="14" stroke="currentColor" stroke-linecap="square" stroke-width="2" viewBox="0 0 24 24" width="14"><path d="M5 12h14"></path><path d="M12 5l7 7-7 7"></path></svg>
                    </button>
                </div>
            </div>
        </section>

        <!-- 2. THE CORE PHILOSOPHY -->
        <section class="py-24 px-8 md:px-16 lg:px-24 bg-[#FAFAFA] text-[#1C1C1E]">
            <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16">
                <div>
                    <h2 class="font-serif text-[2.5rem] leading-[1.2] max-w-md">The right home<br/>starts with you.</h2>
                </div>
                <div>
                    <ul class="flex flex-col gap-8">
                        <li class="flex gap-6 items-start border-b-[0.5px] border-[#55555a26] pb-8">
                            <div class="w-2 h-2 mt-2 bg-[#BE7555] shrink-0"></div>
                            <div>
                                <h3 class="font-serif text-[1.5rem] mb-2">Does it fit your life?</h3>
                                <p class="text-[#55555A] text-[0.95rem] leading-relaxed">Beyond floorplans, we evaluate commute corridors, schooling infrastructure, and lifestyle alignment.</p>
                            </div>
                        </li>
                        <li class="flex gap-6 items-start border-b-[0.5px] border-[#55555a26] pb-8">
                            <div class="w-2 h-2 mt-2 bg-[#1C1C1E] shrink-0"></div>
                            <div>
                                <h3 class="font-serif text-[1.5rem] mb-2">Is the premium justified?</h3>
                                <p class="text-[#55555A] text-[0.95rem] leading-relaxed">We strip away marketing fluff to analyze actual carpet area efficiency, loading factors, and secondary market pricing data.</p>
                            </div>
                        </li>
                        <li class="flex gap-6 items-start">
                            <div class="w-2 h-2 mt-2 bg-[#BE7555] shrink-0"></div>
                            <div>
                                <h3 class="font-serif text-[1.5rem] mb-2">Can the developer deliver?</h3>
                                <p class="text-[#55555A] text-[0.95rem] leading-relaxed">We audit the developer's execution track record, financial leverage, and RERA compliance history.</p>
                            </div>
                        </li>
                    </ul>
                </div>
            </div>
        </section>

        <!-- 3. BUYER ARCHETYPES -->
        <section class="py-24 px-8 md:px-16 lg:px-24 bg-[#1C1C1E] text-[#FAFAFA]">
            <div class="max-w-7xl mx-auto">
                <h2 class="font-serif text-[2.5rem] leading-[1.2] max-w-2xl mb-16">For buyers who expect<br/>more from their search.</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    
                    <!-- Card 1 -->
                    <div class="relative w-full h-[550px] rounded-sm overflow-hidden flex flex-col justify-end group shadow-xl border-[0.5px] border-white/10">
                        <div class="absolute inset-0 bg-[url('/new-ak/assets/evergreen/prestige_evergreen_hero_tower_facade_day.webp')] bg-cover bg-center contrast-[1.05] group-hover:scale-105 transition-transform duration-[800ms] ease-out"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-[#1C1C1E] from-40% via-[#1C1C1E]/80 via-75% to-transparent h-[85%] mt-auto"></div>
                        <div class="relative z-10 p-8 flex flex-col gap-4">
                            <div class="font-sans text-[0.7rem] font-bold tracking-[0.15em] uppercase text-[#BE7555]">01. The Time-Poor Executive</div>
                            <div class="font-serif text-[1.75rem] text-[#FAFAFA] leading-[1.2]">You know what you want. You just don't have the time to find it.</div>
                            <p class="font-sans text-[0.95rem] text-[#FAFAFA]/90 leading-relaxed">We filter the noise and curate only the top 1% of assets that strictly match your mandates.</p>
                        </div>
                    </div>
                    
                    <!-- Card 2 -->
                    <div class="relative w-full h-[550px] rounded-sm overflow-hidden flex flex-col justify-end group shadow-xl border-[0.5px] border-white/10">
                        <div class="absolute inset-0 bg-[url('/new-ak/assets/evergreen/prestige_evergreen_hero_pool_evening.webp')] bg-cover bg-center contrast-[1.05] group-hover:scale-105 transition-transform duration-[800ms] ease-out"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-[#1C1C1E] from-40% via-[#1C1C1E]/80 via-75% to-transparent h-[85%] mt-auto"></div>
                        <div class="relative z-10 p-8 flex flex-col gap-4">
                            <div class="font-sans text-[0.7rem] font-bold tracking-[0.15em] uppercase text-[#BE7555]">02. The Thoughtful Buyer</div>
                            <div class="font-serif text-[1.75rem] text-[#FAFAFA] leading-[1.2]">You want an honest opinion, not another sales pitch.</div>
                            <p class="font-sans text-[0.95rem] text-[#FAFAFA]/90 leading-relaxed">For buyers who want to understand the numbers, plans, and trade-offs before committing significant capital.</p>
                        </div>
                    </div>
                    
                    <!-- Card 3 -->
                    <div class="relative w-full h-[550px] rounded-sm overflow-hidden flex flex-col justify-end group shadow-xl border-[0.5px] border-white/10">
                        <div class="absolute inset-0 bg-[url('/new-ak/assets/sobha_oneworld/sobha_oneworld_hero_elevation_night.webp')] bg-cover bg-center contrast-[1.05] group-hover:scale-105 transition-transform duration-[800ms] ease-out"></div>
                        <div class="absolute inset-0 bg-gradient-to-t from-[#1C1C1E] from-40% via-[#1C1C1E]/80 via-75% to-transparent h-[85%] mt-auto"></div>
                        <div class="relative z-10 p-8 flex flex-col gap-4">
                            <div class="font-sans text-[0.7rem] font-bold tracking-[0.15em] uppercase text-[#BE7555]">03. The Remote NRI</div>
                            <div class="font-serif text-[1.75rem] text-[#FAFAFA] leading-[1.2]">Buying from afar, with someone you can trust on the ground.</div>
                            <p class="font-sans text-[0.95rem] text-[#FAFAFA]/90 leading-relaxed">End-to-end management from virtual site-tours to compliance execution and ultimate handover.</p>
                        </div>
                    </div>

                </div>
            </div>
        </section>

    
        <!-- 4. THE 4-PILLAR FRAMEWORK -->
        <section class="py-24 px-8 md:px-16 lg:px-24 bg-[#FAFAFA] text-[#1C1C1E] border-t-[0.5px] border-[#55555a26]">
            <div class="max-w-7xl mx-auto">
                <h2 class="font-serif text-[2.5rem] leading-[1.2] max-w-2xl mb-16">A great property can<br/>still be the wrong purchase.</h2>
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                    <div class="border-[0.5px] border-[#55555a26] p-8 rounded-sm bg-white shadow-sm hover:shadow-md transition-shadow">
                        <div class="w-8 h-8 rounded-full bg-[#1C1C1E] flex items-center justify-center text-white mb-6">01</div>
                        <h3 class="font-serif text-[1.5rem] mb-4 text-[#1C1C1E]">Location</h3>
                        <p class="text-[#55555A] text-[0.9rem] leading-relaxed">Infrastructure pipelines, school catchments, and micro-market saturation.</p>
                    </div>
                    <div class="border-[0.5px] border-[#55555a26] p-8 rounded-sm bg-white shadow-sm hover:shadow-md transition-shadow">
                        <div class="w-8 h-8 rounded-full bg-[#1C1C1E] flex items-center justify-center text-white mb-6">02</div>
                        <h3 class="font-serif text-[1.5rem] mb-4 text-[#1C1C1E]">Developer</h3>
                        <p class="text-[#55555A] text-[0.9rem] leading-relaxed">Financial leverage, delivery track record, and legal compliance history.</p>
                    </div>
                    <div class="border-[0.5px] border-[#55555a26] p-8 rounded-sm bg-white shadow-sm hover:shadow-md transition-shadow">
                        <div class="w-8 h-8 rounded-full bg-[#1C1C1E] flex items-center justify-center text-white mb-6">03</div>
                        <h3 class="font-serif text-[1.5rem] mb-4 text-[#1C1C1E]">Property</h3>
                        <p class="text-[#55555A] text-[0.9rem] leading-relaxed">Carpet efficiency, loading factors, natural light, and structural integrity.</p>
                    </div>
                    <div class="border-[0.5px] border-[#55555a26] p-8 rounded-sm bg-white shadow-sm hover:shadow-md transition-shadow">
                        <div class="w-8 h-8 rounded-full bg-[#BE7555] flex items-center justify-center text-white mb-6">04</div>
                        <h3 class="font-serif text-[1.5rem] mb-4 text-[#BE7555]">You</h3>
                        <p class="text-[#55555A] text-[0.9rem] leading-relaxed">Aligning the asset with your long-term capital and lifestyle goals.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 5. ADVISORY PROCESS -->
        <section class="py-24 px-8 md:px-16 lg:px-24 bg-[#1C1C1E] text-[#FAFAFA]">
            <div class="max-w-7xl mx-auto">
                <h2 class="font-serif text-[2.5rem] leading-[1.2] max-w-2xl mb-16">From property search to possession.<br/>We stay on your side.</h2>
                
                <div class="flex flex-col gap-0 border-l-[0.5px] border-white/20 ml-4 pl-8 md:ml-8 md:pl-12">
                    <div class="relative pb-16">
                        <div class="absolute w-3 h-3 rounded-full bg-[#BE7555] -left-[38px] md:-left-[54px] top-2"></div>
                        <div class="text-[0.7rem] font-bold tracking-[0.15em] uppercase text-[#BE7555] mb-2">Phase 01</div>
                        <h3 class="font-serif text-[1.75rem] mb-3">Clarify</h3>
                        <p class="text-[#FAFAFA]/70 text-[0.95rem] leading-relaxed max-w-2xl">We define your strict investment mandates, eliminating emotional biases and setting objective financial parameters.</p>
                    </div>
                    <div class="relative pb-16">
                        <div class="absolute w-3 h-3 rounded-full bg-white/20 -left-[38px] md:-left-[54px] top-2"></div>
                        <div class="text-[0.7rem] font-bold tracking-[0.15em] uppercase text-[#FAFAFA]/50 mb-2">Phase 02</div>
                        <h3 class="font-serif text-[1.75rem] mb-3">Optimize</h3>
                        <p class="text-[#FAFAFA]/70 text-[0.95rem] leading-relaxed max-w-2xl">Filtering the noise. We evaluate 50+ projects to curate the top 3 assets that mathematically align with your mandate.</p>
                    </div>
                    <div class="relative pb-16">
                        <div class="absolute w-3 h-3 rounded-full bg-white/20 -left-[38px] md:-left-[54px] top-2"></div>
                        <div class="text-[0.7rem] font-bold tracking-[0.15em] uppercase text-[#FAFAFA]/50 mb-2">Phase 03</div>
                        <h3 class="font-serif text-[1.75rem] mb-3">Risk Audit</h3>
                        <p class="text-[#FAFAFA]/70 text-[0.95rem] leading-relaxed max-w-2xl">Conducting our proprietary 69-point technical, legal, and commercial due diligence before you commit capital.</p>
                    </div>
                    <div class="relative pb-8">
                        <div class="absolute w-3 h-3 rounded-full bg-white/20 -left-[38px] md:-left-[54px] top-2"></div>
                        <div class="text-[0.7rem] font-bold tracking-[0.15em] uppercase text-[#FAFAFA]/50 mb-2">Phase 04</div>
                        <h3 class="font-serif text-[1.75rem] mb-3">Execution</h3>
                        <p class="text-[#FAFAFA]/70 text-[0.95rem] leading-relaxed max-w-2xl">We negotiate the terms, secure the inventory, and manage the compliance paperwork through to final possession.</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 6. THE ADVISORY TEAM -->
        <section class="py-24 px-8 md:px-16 lg:px-24 bg-[#FAFAFA] text-[#1C1C1E] border-t-[0.5px] border-[#55555a26]">
            <div class="max-w-7xl mx-auto">
                <h2 class="font-serif text-[2.5rem] leading-[1.2] max-w-2xl mb-4">Built by professionals.<br/>Shaped by real buyer lessons.</h2>
                <div class="font-sans text-[0.8rem] font-bold tracking-[0.1em] uppercase text-[#BE7555] mb-16">Meet The Team</div>
                
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <!-- Nitin -->
                    <div class="group cursor-pointer">
                        <div class="relative w-full h-[350px] rounded-sm overflow-hidden mb-6 border-[0.5px] border-[#55555a26]">
                            <div class="absolute inset-0 bg-[#1C1C1E] opacity-10 mix-blend-multiply group-hover:opacity-0 transition-opacity duration-500 z-10"></div>
                            <img src="/new-ak/assets/nitin_gupta.webp" alt="Nitin Gupta" class="w-full h-full object-cover grayscale opacity-90 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700">
                        </div>
                        <h3 class="font-serif text-[1.5rem] text-[#1C1C1E] mb-1">Nitin Gupta</h3>
                        <p class="font-sans text-[0.85rem] text-[#55555A]">Founding Partner</p>
                    </div>
                    <!-- Gaurav -->
                    <div class="group cursor-pointer">
                        <div class="relative w-full h-[350px] rounded-sm overflow-hidden mb-6 border-[0.5px] border-[#55555a26]">
                            <div class="absolute inset-0 bg-[#1C1C1E] opacity-10 mix-blend-multiply group-hover:opacity-0 transition-opacity duration-500 z-10"></div>
                            <img src="/new-ak/assets/gaurav_mongia.webp" alt="Gaurav Mongia" class="w-full h-full object-cover grayscale opacity-90 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-700">
                        </div>
                        <h3 class="font-serif text-[1.5rem] text-[#1C1C1E] mb-1">Gaurav Mongia</h3>
                        <p class="font-sans text-[0.85rem] text-[#55555A]">Founding Partner</p>
                    </div>
                    <!-- Arvind -->
                    <div class="group cursor-pointer">
                        <div class="relative w-full h-[350px] rounded-sm overflow-hidden mb-6 border-[0.5px] border-[#55555a26] bg-[#1C1C1E]/5 flex items-center justify-center">
                            <div class="font-serif text-[4rem] text-[#1C1C1E]/10">AP</div>
                        </div>
                        <h3 class="font-serif text-[1.5rem] text-[#1C1C1E] mb-1">Arvind Patidar</h3>
                        <p class="font-sans text-[0.85rem] text-[#55555A]">Founding Partner</p>
                    </div>
                </div>
            </div>
        </section>

        <!-- 7. SEO CONTENT -->
        <section class="py-24 px-8 md:px-16 lg:px-24 bg-white text-[#1C1C1E] border-t-[0.5px] border-[#55555a26]">
            <div class="max-w-4xl mx-auto">
                <h2 class="font-serif text-[2.5rem] leading-[1.2] mb-12">Property Consultant in <span class="text-[#BE7555]">Bangalore</span></h2>
                
                <div class="prose prose-lg prose-headings:font-serif prose-headings:text-[#1C1C1E] prose-p:text-[#55555A] prose-p:leading-relaxed max-w-none">
                    <h3>Independent Buyer-Side Property Advisory</h3>
                    <p>Navigating the Bangalore real estate market requires more than just access to inventory. As independent property consultants in Bangalore, we operate exclusively on the buyer's side of the table, ensuring that capital is deployed efficiently and risks are mitigated.</p>
                    
                    <h3>Property Evaluation, Due Diligence & Risk Assessment</h3>
                    <p>We believe a great property can still be the wrong purchase if the legal structure or commercial pricing is flawed. Our proprietary 69-point diligence framework audits developer history, RERA compliance, layout efficiency, and financial viability.</p>
                    
                    <h3>Home Buyer Concierge by acre&key</h3>
                    <p>Our mandate is simple: we help you buy the right home. Through rigorous data analytics, local market intelligence, and uncompromised transparency, acre&key stands as the premier advisory firm for high-net-worth individuals and NRIs seeking residential real estate in Bangalore.</p>
                </div>
            </div>
        </section>

        <!-- 8. FAQ -->
        <section class="py-24 px-8 md:px-16 lg:px-24 bg-[#FAFAFA] text-[#1C1C1E] border-t-[0.5px] border-[#55555a26]">
            <div class="max-w-4xl mx-auto">
                <h2 class="font-serif text-[2.5rem] leading-[1.2] mb-12 max-w-2xl">Frequently Asked Questions About Property Consultants in Bangalore</h2>
                
                <div class="border-t-[0.5px] border-[#55555a26]">
                    <details class="group py-6 border-b-[0.5px] border-[#55555a26] cursor-pointer">
                        <summary class="flex justify-between items-center font-serif text-[1.25rem] text-[#1C1C1E] list-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1C1C1E] rounded-sm">
                            The Role of a Buyer-Side Consultant
                            <span class="transform group-open:rotate-180 transition-transform text-[#BE7555]">+</span>
                        </summary>
                        <p class="mt-4 text-[#55555A] text-[0.95rem] leading-relaxed pl-2">Unlike traditional brokers who represent the seller's inventory, a buyer-side consultant represents your capital. We evaluate properties objectively against your mandate without bias toward any specific developer.</p>
                    </details>
                    <details class="group py-6 border-b-[0.5px] border-[#55555a26] cursor-pointer">
                        <summary class="flex justify-between items-center font-serif text-[1.25rem] text-[#1C1C1E] list-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1C1C1E] rounded-sm">
                            69-Point Due Diligence & Evaluation
                            <span class="transform group-open:rotate-180 transition-transform text-[#BE7555]">+</span>
                        </summary>
                        <p class="mt-4 text-[#55555A] text-[0.95rem] leading-relaxed pl-2">Our framework assesses 69 specific data points including loading percentages, carpet efficiency, masterplan flow, developer leverage, and micro-market supply pipelines.</p>
                    </details>
                    <details class="group py-6 border-b-[0.5px] border-[#55555a26] cursor-pointer">
                        <summary class="flex justify-between items-center font-serif text-[1.25rem] text-[#1C1C1E] list-none focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#1C1C1E] rounded-sm">
                            Pricing, Negotiation & Commercial Transparency
                            <span class="transform group-open:rotate-180 transition-transform text-[#BE7555]">+</span>
                        </summary>
                        <p class="mt-4 text-[#55555A] text-[0.95rem] leading-relaxed pl-2">We leverage secondary market data and institutional benchmarks to negotiate from a position of authority, ensuring you never overpay for premium positioning.</p>
                    </details>
                </div>
            </div>
        </section>

        <!-- 9. LEAD FORM -->
        <section class="py-24 px-8 md:px-16 lg:px-24 bg-[#1C1C1E] text-[#FAFAFA] flex justify-center">
            <div class="w-full max-w-2xl bg-white text-[#1C1C1E] p-12 rounded-sm shadow-2xl border-[0.5px] border-[#55555a26]">
                <div class="text-center mb-10">
                    <h2 class="font-serif text-[2.5rem] mb-4">Speak to a Home Buying Expert</h2>
                    <p class="text-[#55555A] text-[1rem]">Tell us what you're looking for, and our advisors will help you shortlist, evaluate, and negotiate the right property.</p>
                </div>
                
                <form class="flex flex-col gap-6">
                    <div>
                        <label class="block text-[0.75rem] font-bold uppercase tracking-[0.1em] text-[#1C1C1E] mb-2">Full Name <span class="text-[#8B3A3A]">*</span></label>
                        <input type="text" class="w-full h-12 bg-[#FAFAFA] border-[0.5px] border-[#55555a26] rounded-sm px-4 focus:outline-none focus:ring-2 focus:ring-[#1C1C1E] text-[1rem]" required>
                    </div>
                    <div>
                        <label class="block text-[0.75rem] font-bold uppercase tracking-[0.1em] text-[#1C1C1E] mb-2">Mobile <span class="text-[#8B3A3A]">*</span></label>
                        <div class="flex">
                            <div class="h-12 bg-[#FAFAFA] border-[0.5px] border-[#55555a26] border-r-0 rounded-l-sm px-4 flex items-center justify-center text-[0.9rem] font-bold text-[#55555A] shrink-0">+91</div>
                            <input type="tel" class="w-full h-12 bg-[#FAFAFA] border-[0.5px] border-[#55555a26] rounded-r-sm px-4 focus:outline-none focus:ring-2 focus:ring-[#1C1C1E] text-[1rem]" required>
                        </div>
                    </div>
                    <div>
                        <label class="block text-[0.75rem] font-bold uppercase tracking-[0.1em] text-[#1C1C1E] mb-2">Email <span class="text-[#8B3A3A]">*</span></label>
