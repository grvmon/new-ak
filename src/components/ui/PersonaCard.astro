---
// src/components/ui/PersonaCard.astro
interface Props {
  number: string;
  title: string;
  imageSrc: string;
  class?: string;
}

const { number, title, imageSrc, class: className = '' } = Astro.props;
---

<div class={`relative w-full max-w-sm aspect-[3/4] rounded-sm overflow-hidden group ${className}`}>
  <img src={imageSrc} alt={title} class="w-full h-full object-cover img-filtered transition-transform duration-[800ms] group-hover:scale-105" />
  
  <div class="absolute inset-0 pointer-events-none" style="background: linear-gradient(to top, rgba(28, 28, 30, 0.95) 0%, rgba(28, 28, 30, 0.4) 40%, transparent 100%)"></div>
  
  <div class="absolute bottom-8 left-8 right-8 text-white z-10">
    <div class="font-serif text-3xl text-primary-peach mb-2">{number}</div>
    <h3 class="font-sans font-bold text-xl mb-4">{title}</h3>
    <div class="font-sans text-[0.9rem] opacity-80 leading-relaxed space-y-4">
      <slot />
    </div>
  </div>
</div>
