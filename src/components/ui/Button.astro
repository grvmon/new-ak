---
// src/components/ui/Button.astro
interface Props {
  variant?: 'primary' | 'secondary' | 'ghost';
  href?: string;
  class?: string;
  type?: 'button' | 'submit' | 'reset';
}

const { variant = 'primary', href, class: className = '', type = 'button', ...rest } = Astro.props;

const baseClasses = 'inline-flex justify-center items-center font-sans text-[0.85rem] rounded-sm transition-all duration-400 ease-out cursor-pointer';

const variants = {
  primary: 'px-6 py-3 bg-gradient-to-br from-[#be7555] to-[#9f5334] text-white font-normal hover:opacity-90 border-none',
  secondary: 'px-6 py-3 bg-transparent border-[0.5px] border-canvas-dark text-canvas-dark font-normal hover:bg-canvas-dark hover:text-white',
  ghost: 'block text-center p-4 border-[0.5px] border-primary-copper font-bold text-primary-copper uppercase tracking-[0.05em] hover:bg-primary-copper hover:text-white',
};

const classes = `${baseClasses} ${variants[variant]} ${className}`;
---

{
  href ? (
    <a href={href} class={classes} {...rest}>
      <slot />
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
    </button>
  )
}
