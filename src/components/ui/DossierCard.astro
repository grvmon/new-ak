---
// src/components/ui/DossierCard.astro
import Card from './Card.astro';
import Badge from './Badge.astro';
import Button from './Button.astro';

interface Props {
  title: string;
  location: string;
  typology: string;
  price: string;
  imageSrc: string;
  href: string;
  badgeText?: string;
  class?: string;
}

const { 
  title, 
  location, 
  typology, 
  price, 
  imageSrc, 
  href, 
  badgeText = 'A-Grade Asset',
  class: className = ''
} = Astro.props;
---

<Card padding="none" class={`overflow-hidden max-w-md group ak-pan-container ${className}`}>
  <!-- Image Area with Dual Anchored Gradients -->
  <div class="relative h-64 overflow-hidden">
    <img src={imageSrc} alt={title} class="ak-image-pan img-filtered" />
    
    <!-- Unified Dual Gradient protecting both top tags and bottom typography -->
    <div class="anchored-gradient-dual"></div>
    
    <div class="absolute top-4 left-4 z-10">
      <Badge variant="dark" class="bg-black/80">{badgeText}</Badge>
    </div>

    <div class="absolute bottom-4 left-4 right-4 text-white z-10">
      <h3 class="truncate">{title}</h3>
      <p class="font-sans opacity-80" style="font-size: var(--text-fluid-base)">{location}</p>
    </div>
  </div>
  
  <!-- Data Area -->
  <div class="p-6">
    <div class="grid grid-cols-2 gap-4 mb-6">
      <div>
        <div class="font-sans uppercase tracking-[0.1em] text-neutral-grey mb-1" style="font-size: var(--text-fluid-micro)">Typology</div>
        <div class="font-sans font-bold text-canvas-dark truncate" style="font-size: var(--text-fluid-base)">{typology}</div>
      </div>
      <div>
        <div class="font-sans uppercase tracking-[0.1em] text-neutral-grey mb-1" style="font-size: var(--text-fluid-micro)">Starting Price</div>
        <div class="font-sans font-bold text-canvas-dark" style="font-size: var(--text-fluid-base)">{price}</div>
      </div>
    </div>
    <Button variant="ghost" href={href} class="w-full">View Asset Dossier</Button>
  </div>
</Card>
