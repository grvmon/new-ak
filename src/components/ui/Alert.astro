---
// src/components/ui/Alert.astro
interface Props {
  title: string;
  class?: string;
}

const { title, class: className = '' } = Astro.props;
---

<div class={`border-l-[2px] border-primary-copper pl-4 py-3 bg-white ${className}`}>
  <strong class="block mb-1 font-bold font-sans text-[0.95rem] text-canvas-dark">{title}</strong>
  <div class="text-neutral-grey font-sans text-sm">
    <slot />
  </div>
</div>
